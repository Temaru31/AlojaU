# Copia a backend/.env -> cp .env.example .env  (NUNCA subir .env a GitHub)
# DEV local:
ENV=dev
DATABASE_URL=postgresql+asyncpg://alojau:alojau123@localhost:5432/alojau
SECRET_KEY=cambia_esto_por_algo_largo_y_secreto_min_32_chars
ALGORITHM=HS256
# 2h: acorta la ventana de exposición del Bearer en localStorage.
ACCESS_TOKEN_EXPIRE_HOURS=2
USE_MOCK_FALLBACK=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Pesos del índice de confianza (40 + 20 + 15 + 15 + 10 = 100)
TRUST_WEIGHT_COMPLETITUD=40
TRUST_WEIGHT_TELEFONO=20
TRUST_WEIGHT_FOTOS=15
TRUST_WEIGHT_VIGENCIA=15
TRUST_WEIGHT_REPORTES=10

# F3 Cloudinary (persistencia prod). Vacío = storage local efímero (dev).
# En Render: setear las 3 + CLOUDINARY_FOLDER=alojau. Nunca subir .env real.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=alojau

# Para Supabase: reemplaza DATABASE_URL por la de Supabase (Session Pooler) y pon supabase URL
# PROD (Render/Supabase) - OBLIGATORIO fail-closed RLS/SEC:
# ENV=prod
# SECRET_KEY=<64 hex: openssl rand -hex 32>  # NUNCA el default, >=32 chars
# USE_MOCK_FALLBACK=False
# CORS_ORIGINS=https://aloja-u.vercel.app,http://localhost:5173
# DATABASE_URL=postgresql+asyncpg://postgres.xxx:[PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres?ssl=require
# Backend usa owner asyncpg (bypassa RLS por diseño). NO usar FORCE RLS (rompe backend).

# v13 Enterprise Auth (Google OAuth + JWKS). Vacío = proveedor local HS256.
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_JWKS_URL=  # opcional; por defecto {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# SUPABASE_AUD=authenticated
# SUPABASE_ANON_KEY=
# FRONTEND_URL=http://localhost:5173
# FRONTEND_PROD_URL=https://aloja-u.vercel.app
# POLITICA_VERSION=v1.0-ley1581-2026
# OTP alternativo gratuito (Telegram Bot). Vacío = solo Email-code (log en dev).
# M5: los OTP NUNCA van a canales/grupos (TELEGRAM_CHAT_ID legacy no se usa
# para OTP); solo por DM al telegram_chat_id vinculado del usuario.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# M5 vinculación $0 (username público del bot, sin @):
# TELEGRAM_BOT_USERNAME=AlojaU_bot
# Bloque 1 fix webhook productivo (causa raíz del bug "/start no detectado"):
# 1) Setea BOT_TOKEN + BOT_USERNAME + WEBHOOK_SECRET en Render.
# 2) Registra UNA vez: curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook"
#    -H "Content-Type: application/json"
#    -d '{"url":"https://<tu-api>.onrender.com/api/auth/telegram/webhook","secret_token":"<WEBHOOK_SECRET>"}'
# 3) El bot debe tener /setprivacy DISABLED? No: basta que el webhook reciba
#    mensajes privados. El token ?start= es URL-safe "_" (<=64 chars).
# TELEGRAM_WEBHOOK_SECRET=<openssl rand -hex 24>
# TELEGRAM_WEBHOOK_URL=https://<tu-api>.onrender.com/api/auth/telegram/webhook

# Chatbot MVP (solo lectura, mig 021). Apagado por defecto (CHAT_ENABLED=false).
# Sin CHAT_DATABASE_URL el bot responde deshabilitado; NUNCA usa DATABASE_URL.
# CHAT_ENABLED=false
# CHAT_DATABASE_URL=postgresql+asyncpg://chatbot_ro.<project-ref>:<SECRETO>@aws-0-us-east-2.pooler.supabase.com:5432/postgres
# (pooler de Supabase: el usuario lleva el sufijo .<project-ref>; el password
#  se define con ALTER ROLE chatbot_ro WITH LOGIN PASSWORD '...' como superuser
#  en el SQL Editor, NUNCA en el repo. Ver mig 021 para crear el rol.)
# Proveedor LLM del chatbot (Fase 2, adapter OpenAI-compatible por urllib).
# Default "fake" = sin red (tests + deshabilitado real). Para activar con un
# proveedor real: CHAT_ENABLED=true + CHAT_DATABASE_URL + estas 4. La llave
# solo en .env local (gitignored) o dashboard Render, NUNCA en el repo/chat.
# CHAT_LLM_PROVIDER=fake
# CHAT_LLM_BASE_URL=https://api.groq.com/openai/v1
# CHAT_LLM_API_KEY=
# CHAT_LLM_MODEL=llama-3.1-8b-instant
# Defensa en profundidad (defaults sanos; subir solo si el uso legítimo choca):
# CHAT_TIMEOUT_S=20.0
# CHAT_MAX_TOKENS_SALIDA=600
# CHAT_LIMITE_IP_MIN=30
# CHAT_LIMITE_USUARIO_MIN=60
# CHAT_TOPE_DIARIO=2000
